# AWS S3 configuration (used by app/storage.py)
# Copy this file to .env and fill in your real values.
# NEVER commit .env or credentials to version control.

AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=ap-south-1
S3_BUCKET_NAME=your-bucket-name

# Phase 4: Transcript rubric scoring — use one of these:
GEMINI_API_KEY=your-gemini-api-key        # free at aistudio.google.com (preferred)
ANTHROPIC_API_KEY=your-anthropic-api-key  # paid fallback
