# Git ignore file for Proof-of-Work Analyzer
# ─── Python ──────────────────────────────────────
__pycache__/
*.py[cod]
*.pyd
*.pyo
.pytest_cache/

# ─── Virtual environment ─────────────────────────
venv/

# ─── Environment / secrets ───────────────────────
.env

# ─── Runtime job data ────────────────────────────
data/

# ─── Video files ─────────────────────────────────
*.mp4
*.avi
*.mov
*.mkv

# ─── Scratch / debug ─────────────────────────────
scratch/

# ─── Debug image artefacts ───────────────────────
debug_dip_crops/
debug_out/
