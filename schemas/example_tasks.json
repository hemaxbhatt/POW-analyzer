[
  {
    "task_id": "task_04_bcd_to_7seg_decoder",
    "title": "BCD to 7-Segment Decoder",
    "description": "Student sets a 4-bit BCD value on the DIP switch; the 7-segment display should show the matching digit.",
    "components": {
      "inputs": [
        {
          "id": "sw",
          "type": "dip_switch_4pos",
          "bit_order": [
            8,
            4,
            2,
            1
          ]
        }
      ],
      "outputs": [
        {
          "id": "disp",
          "type": "seven_segment_display"
        }
      ]
    },
    "verification_mode": "state_match",
    "unlisted_input_policy": "must_match_default",
    "default_output": {
      "disp": "invalid"
    },
    "timing": {
      "min_hold_time_ms": 500
    },
    "grading": {
      "all_or_nothing": true
    },
    "expected_behavior": [
      {
        "input": {
          "sw": "0000"
        },
        "output": {
          "disp": "0"
        }
      },
      {
        "input": {
          "sw": "0001"
        },
        "output": {
          "disp": "1"
        }
      },
      {
        "input": {
          "sw": "0010"
        },
        "output": {
          "disp": "2"
        }
      },
      {
        "input": {
          "sw": "0011"
        },
        "output": {
          "disp": "3"
        }
      },
      {
        "input": {
          "sw": "0100"
        },
        "output": {
          "disp": "4"
        }
      },
      {
        "input": {
          "sw": "0101"
        },
        "output": {
          "disp": "5"
        }
      },
      {
        "input": {
          "sw": "0110"
        },
        "output": {
          "disp": "6"
        }
      },
      {
        "input": {
          "sw": "0111"
        },
        "output": {
          "disp": "7"
        }
      },
      {
        "input": {
          "sw": "1000"
        },
        "output": {
          "disp": "8"
        }
      },
      {
        "input": {
          "sw": "1001"
        },
        "output": {
          "disp": "9"
        }
      }
    ],
    "metadata": {
      "unit": "Combinational Logic",
      "points": 10
    }
  },
  {
    "task_id": "task_02_dip_led_and_gate",
    "title": "2-Input AND Gate via DIP Switch and LED",
    "description": "Only switches 1 and 2 matter; LED lights only when both are ON. Switches 3-4 are unused/don't-care.",
    "components": {
      "inputs": [
        {
          "id": "sw",
          "type": "dip_switch_4pos",
          "bit_order": [
            8,
            4,
            2,
            1
          ]
        }
      ],
      "outputs": [
        {
          "id": "led1",
          "type": "led"
        }
      ]
    },
    "verification_mode": "state_match",
    "unlisted_input_policy": "ignore",
    "timing": {
      "min_hold_time_ms": 500
    },
    "grading": {
      "all_or_nothing": true
    },
    "expected_behavior": [
      {
        "input": {
          "sw": "0000"
        },
        "output": {
          "led1": "off"
        },
        "note": "switches 3-4 don't-care, only using pattern where they're 0"
      },
      {
        "input": {
          "sw": "0001"
        },
        "output": {
          "led1": "off"
        }
      },
      {
        "input": {
          "sw": "0010"
        },
        "output": {
          "led1": "off"
        }
      },
      {
        "input": {
          "sw": "0011"
        },
        "output": {
          "led1": "on"
        }
      }
    ],
    "metadata": {
      "unit": "Combinational Logic",
      "points": 5
    }
  },
  {
    "task_id": "task_09_pushbutton_counter",
    "title": "Push-Button Driven 0-3 Counter on 7-Segment",
    "description": "DIP switches are not used. Each press of the push button should advance the 7-segment display by 1, wrapping from 3 back to 0. Sequence must occur in order.",
    "components": {
      "inputs": [
        {
          "id": "btn",
          "type": "push_button"
        }
      ],
      "outputs": [
        {
          "id": "disp",
          "type": "seven_segment_display"
        }
      ]
    },
    "verification_mode": "sequence_match",
    "timing": {
      "min_hold_time_ms": 200,
      "max_gap_ms": null
    },
    "grading": {
      "all_or_nothing": false,
      "pass_threshold": 0.75
    },
    "expected_behavior": [
      {
        "step": 1,
        "trigger": {
          "input_state": {}
        },
        "output": {
          "disp": "0"
        },
        "note": "initial/reset state before any press"
      },
      {
        "step": 2,
        "trigger": {
          "event": "button_press",
          "component_id": "btn"
        },
        "output": {
          "disp": "1"
        }
      },
      {
        "step": 3,
        "trigger": {
          "event": "button_press",
          "component_id": "btn"
        },
        "output": {
          "disp": "2"
        }
      },
      {
        "step": 4,
        "trigger": {
          "event": "button_press",
          "component_id": "btn"
        },
        "output": {
          "disp": "3"
        }
      },
      {
        "step": 5,
        "trigger": {
          "event": "button_press",
          "component_id": "btn"
        },
        "output": {
          "disp": "0"
        },
        "note": "wraps around"
      }
    ],
    "metadata": {
      "unit": "Sequential Logic",
      "points": 15
    }
  },
